FUNCTION besaranPenggunaan
  DECLARE penggunaanListrik : INTEGER
BEGIN
  INPUT(penggunaanListrik)
    IF penggunaanListrik < 100
      THEN 
        result <- penggunaanListrik*2000
      ELSEIF penggunaanListrik < 200
        result <- penggunaanListrik*3000
      ELSE
        result <- penggunaanListrik*5000
    ENDIF
END
